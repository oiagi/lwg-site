# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin dashboard login uses Supabase Auth users, not env vars.
# Create the admin email/password in Supabase Authentication.

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key

# ── Google OAuth (calendar integration) ──────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Site URL (used for OAuth redirects) ──────────────────────────
# Set to the base URL where the site is hosted. Falls back to
# the request origin if omitted (safe for local dev).
# SITE_URL=http://localhost:8788

# Optional exact OAuth redirect URI. If set, this exact URI must also be
# registered in Google Cloud Console for the OAuth client.
# GOOGLE_REDIRECT_URI=http://localhost:8788/api/auth-callback

# ── Swiss QR-bill (invoice payment part) ─────────────────────────
# QR-IBAN of the account invoices are paid into (positions 5–9 must be
# 30000–31999). Without it the admin cannot add a payment part to invoices.
# QR_BILL_IBAN=CH4431999123000889012
# Account holder name exactly as registered with the bank. Optional;
# defaults to "Birukoff World c/o Gioia Birukoff".
# QR_BILL_CREDITOR_NAME=Birukoff World c/o Gioia Birukoff

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# (defaults to https://learningwithgioia.ch,https://oiagi.org,http://localhost)
# ALLOWED_ORIGINS=https://learningwithgioia.ch,http://localhost:8788
