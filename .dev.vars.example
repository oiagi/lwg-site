# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key

# ── Google OAuth (calendar integration) ──────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Site URL (used for OAuth redirects) ──────────────────────────
# Set to the base URL where the site is hosted. Falls back to
# the request origin if omitted (safe for local dev).
# SITE_URL=http://localhost:8788

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (defaults to https://oiagi.org,http://localhost)
# ALLOWED_ORIGINS=https://oiagi.org,http://localhost:8788

# ── Invoicing / QR-bill ─────────────────────────────────────────
QR_IBAN=CH00 0000 0000 0000 0000 0
CREDITOR_NAME=Learning with Gioia
CREDITOR_STREET=Street Name
CREDITOR_HOUSE_NUMBER=1
CREDITOR_POSTAL_CODE=8000
CREDITOR_CITY=Zürich
CREDITOR_COUNTRY=CH
